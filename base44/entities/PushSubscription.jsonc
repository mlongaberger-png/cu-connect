{
  "name": "PushSubscription",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the subscribed user"
    },
    "endpoint": {
      "type": "string",
      "description": "Push endpoint URL (web) or synthetic fcm:<token> identifier (native)"
    },
    "p256dh_key": {
      "type": "string",
      "description": "Public encryption key (web push only)"
    },
    "auth_key": {
      "type": "string",
      "description": "Auth secret (web push only)"
    },
    "platform": {
      "type": "string",
      "enum": [
        "web",
        "ios",
        "android"
      ],
      "default": "web",
      "description": "Which push delivery path this subscription uses"
    },
    "fcm_token": {
      "type": "string",
      "description": "Native FCM device token (iOS/Android only; bridged from APNs on iOS by @capacitor-firebase/messaging)"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "user_email",
    "endpoint"
  ],
  "rls": {
    "create": {
      "user_email": "{{user.email}}"
    },
    "read": {
      "user_email": "{{user.email}}"
    },
    "update": {
      "user_email": "{{user.email}}"
    },
    "delete": {
      "user_email": "{{user.email}}"
    }
  }
}