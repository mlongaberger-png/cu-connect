{
  "name": "CoachProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Link to User table"
    },
    "user_email": {
      "type": "string",
      "description": "Denormalized coach email"
    },
    "user_name": {
      "type": "string",
      "description": "Denormalized coach name"
    },
    "team_id": {
      "type": "string",
      "description": "Active team assignment"
    },
    "team_name": {
      "type": "string",
      "description": "Denormalized team name"
    },
    "sport_type": {
      "type": "string",
      "enum": [
        "football",
        "baseball",
        "cheer"
      ],
      "description": "Sport this profile belongs to"
    },
    "role_type": {
      "type": "string",
      "enum": [
        "head_coach",
        "assistant_coach",
        "manager"
      ],
      "default": "assistant_coach"
    },
    "bg_check_passed": {
      "type": "boolean",
      "default": false,
      "description": "DEPRECATED Aug 2026 -- moved to CoachCompliance (one record per coach instead of per team assignment, to avoid duplicate/conflicting values for coaches on multiple teams). No longer read or written by the app; left in place rather than risking a schema-removal side effect."
    },
    "bg_check_expires": {
      "type": "string",
      "format": "date",
      "description": "DEPRECATED Aug 2026 -- moved to CoachCompliance (one record per coach instead of per team assignment, to avoid duplicate/conflicting values for coaches on multiple teams). No longer read or written by the app; left in place rather than risking a schema-removal side effect."
    },
    "nays_completed": {
      "type": "boolean",
      "default": false,
      "description": "DEPRECATED Aug 2026 -- moved to CoachCompliance (one record per coach instead of per team assignment, to avoid duplicate/conflicting values for coaches on multiple teams). No longer read or written by the app; left in place rather than risking a schema-removal side effect."
    },
    "nays_expires": {
      "type": "string",
      "format": "date",
      "description": "DEPRECATED Aug 2026 -- moved to CoachCompliance (one record per coach instead of per team assignment, to avoid duplicate/conflicting values for coaches on multiple teams). No longer read or written by the app; left in place rather than risking a schema-removal side effect."
    },
    "last_reminder_sent": {
      "type": "string",
      "enum": [
        "none",
        "two_month",
        "one_month"
      ],
      "default": "none",
      "description": "DEPRECATED Aug 2026 -- moved to CoachCompliance, which uses a widened six_month/three_month/one_month tier ladder. This field is no longer read or written by the app; left in place rather than risking a schema-removal side effect."
    }
  },
  "required": [
    "user_email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "athletic_director"
          }
        }
      ]
    },
    "read": true,
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "athletic_director"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "athletic_director"
          }
        }
      ]
    }
  }
}