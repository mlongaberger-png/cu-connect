{
  "name": "ChannelMember",
  "properties": {
    "channel_id": {
      "description": "Foreign key to Channel",
      "type": "string"
    },
    "muted": {
      "default": false,
      "description": "Per-person mute for this chat: onMessageCreated sends no push/email to this member, but unread_count still increments",
      "type": "boolean"
    },
    "unread_count": {
      "default": 0,
      "description": "Number of unread messages for this user in this channel",
      "type": "number"
    },
    "user_email": {
      "description": "Member's email",
      "type": "string"
    },
    "user_id": {
      "description": "Member's user ID",
      "type": "string"
    },
    "user_name": {
      "type": "string"
    }
  },
  "required": [
    "channel_id",
    "user_email"
  ],
  "type": "object",
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "athletic_director"
          }
        },
        {
          "user_condition": {
            "role": "coach"
          }
        },
        {
          "data.user_email": "{{user.email}}"
        }
      ]
    },
    "read": true,
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "athletic_director"
          }
        },
        {
          "user_condition": {
            "role": "coach"
          }
        },
        {
          "data.user_email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "athletic_director"
          }
        }
      ]
    }
  }
}