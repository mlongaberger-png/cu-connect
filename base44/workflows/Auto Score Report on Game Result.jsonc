{
  "name": "Auto Score Report on Game Result",
  "description": "Fires when a game/tournament event has its result set. Sends push notifications, posts an announcement, and emails parents automatically.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"result\") != null) and (.trigger.data.result != null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Event"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_score_report_on_game_result",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "onScoreReported",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "onScoreReported"
  }
}