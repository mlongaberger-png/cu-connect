{
  "name": "Notify Parents on New Event",
  "description": "When a new event (game, tournament, practice) is created, push-notify all parent/guardians on that team with a deep-link to the event detail view.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Event"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notify_parents_on_new_event",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "onEventCreated",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "onEventCreated"
  }
}